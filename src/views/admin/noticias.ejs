<%- include('../layouts/header') %>

<div class="admin">
  <%- include('../partials/admin-menu') %>
  <section class="admin-contenido">
    <h1>Noticias</h1>

    <%- include('../partials/mensajes') %>

    <form action="/admin/noticias" method="POST" class="formulario">
      <input type="text" name="titulo" placeholder="Título" value="<%= datos.titulo || '' %>">
      <textarea name="contenido" rows="5" placeholder="Contenido"><%= datos.contenido || '' %></textarea>
      <label class="check">
        <input type="checkbox" name="publicada"> Publicar de una vez
      </label>
      <button type="submit" class="btn">Guardar</button>
    </form>

    <table class="tabla">
      <thead>
        <tr>
          <th>Título</th>
          <th>Fecha</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% noticias.forEach(noticia => { %>
          <tr>
            <td><%= noticia.titulo %></td>
            <td><%= noticia.fecha %></td>
            <td><%= noticia.publicada ? 'Publicada' : 'Borrador' %></td>
            <td class="acciones-tabla">
              <form action="/admin/noticias/<%= noticia.id %>/estado" method="POST">
                <button type="submit" class="btn btn-pequeno"><%= noticia.publicada ? 'Ocultar' : 'Publicar' %></button>
              </form>
              <form action="/admin/noticias/<%= noticia.id %>/eliminar" method="POST" data-confirmar="¿Eliminar esta noticia?">
                <button type="submit" class="btn btn-pequeno btn-peligro">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</div>

<%- include('../layouts/footer') %>
