<%- include('../layouts/header') %>

<div class="admin">
  <%- include('../partials/admin-menu') %>
  <section class="admin-contenido">
    <h1>Padres registrados</h1>

    <% if (usuarios.length === 0) { %>
      <p>Todavía no hay padres registrados.</p>
    <% } else { %>
      <table class="tabla">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Registro</th>
            <th>Último acceso</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach(u => { %>
            <tr>
              <td><%= u.nombre %></td>
              <td><%= u.correo %></td>
              <td><%= u.telefono %></td>
              <td><%= u.fechaRegistro %></td>
              <td><%= u.ultimoAcceso %></td>
              <td><%= u.activo ? 'Activo' : 'Inactivo' %></td>
              <td>
                <form action="/admin/usuarios/<%= u.id %>/estado" method="POST">
                  <button type="submit" class="btn btn-pequeno"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('../layouts/footer') %>
