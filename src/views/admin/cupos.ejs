<%- include('../layouts/header') %>

<div class="admin">
  <%- include('../partials/admin-menu') %>
  <section class="admin-contenido">
    <h1>Cupos</h1>

    <%- include('../partials/mensajes') %>

    <% if (grados.length === 0 || periodos.length === 0) { %>
      <p>Primero debes crear al menos un <a href="/admin/grados">grado</a> y un <a href="/admin/periodos">periodo</a>.</p>
    <% } else { %>
      <h2>Agregar cupos</h2>
      <form action="/admin/cupos" method="POST" class="formulario formulario-linea">
        <select name="gradoId">
          <option value="">Grado</option>
          <% grados.forEach(grado => { %>
            <option value="<%= grado.id %>" <%= String(grado.id) === String(datos.gradoId) ? 'selected' : '' %>><%= grado.nombre %></option>
          <% }) %>
        </select>
        <select name="periodoId">
          <option value="">Periodo</option>
          <% periodos.forEach(periodo => { %>
            <option value="<%= periodo.id %>" <%= String(periodo.id) === String(datos.periodoId) ? 'selected' : '' %>><%= periodo.nombre %></option>
          <% }) %>
        </select>
        <select name="jornada">
          <option value="">Jornada</option>
          <% jornadas.forEach(jornada => { %>
            <option value="<%= jornada %>" <%= jornada === datos.jornada ? 'selected' : '' %>><%= jornada %></option>
          <% }) %>
        </select>
        <input type="number" name="total" min="1" placeholder="Total" value="<%= datos.total || '' %>">
        <input type="number" name="ocupados" min="0" placeholder="Ocupados" value="<%= datos.ocupados || '' %>">
        <button type="submit" class="btn">Agregar</button>
      </form>
    <% } %>

    <h2>Listado</h2>
    <form action="/admin/cupos" method="GET" class="filtro">
      <select name="periodoId">
        <option value="">Todos los periodos</option>
        <% periodos.forEach(periodo => { %>
          <option value="<%= periodo.id %>" <%= String(periodo.id) === filtros.periodoId ? 'selected' : '' %>><%= periodo.nombre %><%= periodo.activo ? ' (activo)' : '' %></option>
        <% }) %>
      </select>
      <select name="gradoId">
        <option value="">Todos los grados</option>
        <% grados.forEach(grado => { %>
          <option value="<%= grado.id %>" <%= String(grado.id) === filtros.gradoId ? 'selected' : '' %>><%= grado.nombre %></option>
        <% }) %>
      </select>
      <select name="jornada">
        <option value="">Todas las jornadas</option>
        <% jornadas.forEach(jornada => { %>
          <option value="<%= jornada %>" <%= jornada === filtros.jornada ? 'selected' : '' %>><%= jornada %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn">Filtrar</button>
    </form>

    <% if (cupos.length === 0) { %>
      <p>No hay cupos con esos filtros.</p>
    <% } else { %>
      <table class="tabla">
        <thead>
          <tr>
            <th>Grado</th>
            <th>Periodo</th>
            <th>Jornada</th>
            <th>Total / Ocupados</th>
            <th>Disponibles</th>
            <th>Ocupación</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% cupos.forEach(cupo => { %>
            <tr>
              <td><%= cupo.grado %></td>
              <td><%= cupo.periodo %></td>
              <td><%= cupo.jornada %></td>
              <td>
                <form action="/admin/cupos/<%= cupo.id %>/actualizar" method="POST" class="formulario-linea">
                  <input type="number" name="total" min="1" value="<%= cupo.total %>" class="input-corto">
                  <input type="number" name="ocupados" min="0" value="<%= cupo.ocupados %>" class="input-corto">
                  <button type="submit" class="btn btn-pequeno">Guardar</button>
                </form>
              </td>
              <td><%= cupo.disponibles %></td>
              <td>
                <div class="barra"><div class="barra-relleno" style="width: <%= cupo.porcentaje %>%"></div></div>
                <small><%= cupo.porcentaje %>%</small>
              </td>
              <td><%- include('../partials/estado-cupo', { estado: cupo.estado }) %></td>
              <td class="acciones-tabla">
                <form action="/admin/cupos/<%= cupo.id %>/ocupar" method="POST">
                  <button type="submit" class="btn btn-pequeno" title="Ocupar un cupo" <%= cupo.hayDisponibles ? '' : 'disabled' %>>+1</button>
                </form>
                <form action="/admin/cupos/<%= cupo.id %>/liberar" method="POST">
                  <button type="submit" class="btn btn-pequeno btn-secundario" title="Liberar un cupo" <%= cupo.ocupados > 0 ? '' : 'disabled' %>>-1</button>
                </form>
                <form action="/admin/cupos/<%= cupo.id %>/eliminar" method="POST" data-confirmar="¿Eliminar estos cupos?">
                  <button type="submit" class="btn btn-pequeno btn-peligro">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('../layouts/footer') %>
