<%- include('../layouts/header') %>

<h1>Cupos disponibles</h1>

<% if (!periodo) { %>
  <p>No hay un periodo de matrículas abierto.</p>
<% } else if (resumen.length === 0) { %>
  <p>Todavía no se han publicado cupos para <%= periodo.nombre %>.</p>
<% } else { %>
  <p>Periodo: <strong><%= periodo.nombre %></strong></p>
  <table class="tabla">
    <thead>
      <tr>
        <th>Grado</th>
        <th>Nivel</th>
        <th>Jornadas</th>
        <th>Estado general</th>
      </tr>
    </thead>
    <tbody>
      <% resumen.forEach(item => { %>
        <tr>
          <td><%= item.grado %></td>
          <td><%= item.nivel %></td>
          <td>
            <% item.jornadas.forEach(j => { %>
              <div><%= j.jornada %>: <%- include('../partials/estado-cupo', { estado: j.estado }) %></div>
            <% }) %>
          </td>
          <td>
            <% if (item.hayDisponibles) { %>
              <span class="etiqueta etiqueta-ok">Con cupos</span>
            <% } else { %>
              <span class="etiqueta etiqueta-no">Sin cupos</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (!usuario) { %>
    <p><a href="/auth/registro">Regístrate</a> para ver la cantidad exacta de cupos por grado y jornada.</p>
  <% } else if (esPadre) { %>
    <p><a href="/padre/cupos">Ver la cantidad exacta de cupos</a></p>
  <% } %>
<% } %>

<%- include('../layouts/footer') %>
