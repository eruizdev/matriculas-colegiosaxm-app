<%- include('../layouts/header') %>

<section class="hero">
  <h1>Bienvenidos al proceso de matrículas</h1>
  <% if (periodo) { %>
    <p>Ya está abierto el periodo <strong><%= periodo.nombre %></strong>.</p>
    <p>Hay <strong><%= cuposDisponibles %></strong> cupos disponibles en este momento.</p>
  <% } else { %>
    <p>Por ahora no hay un periodo de matrículas abierto.</p>
  <% } %>
  <div class="acciones">
    <a href="/cupos" class="btn">Ver cupos</a>
    <a href="/requisitos" class="btn btn-secundario">Requisitos</a>
  </div>
</section>

<section>
  <h2>Últimas noticias</h2>
  <% if (noticias.length === 0) { %>
    <p>No hay noticias publicadas.</p>
  <% } %>
  <div class="tarjetas">
    <% noticias.forEach(noticia => { %>
      <article class="tarjeta">
        <h3><%= noticia.titulo %></h3>
        <small><%= noticia.fecha %></small>
        <p><%= noticia.resumen %></p>
        <a href="/noticias/<%= noticia.id %>">Leer más</a>
      </article>
    <% }) %>
  </div>
</section>

<%- include('../layouts/footer') %>
