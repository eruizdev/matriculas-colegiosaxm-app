  </main>
  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> <%= colegio.nombre %> - Información de cupos y matrículas</p>
    <% if (colegio.tieneContacto()) { %>
      <p>
        <%= [colegio.direccion, colegio.telefono, colegio.correo].filter(Boolean).join(' · ') %>
      </p>
    <% } %>
  </footer>
  <script src="/js/main.js"></script>
</body>
</html>
