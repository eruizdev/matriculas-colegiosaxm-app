<%- include('../layouts/header') %>

<h1>Hola, <%= perfil.nombre %></h1>
<p><a href="/padre/cupos" class="btn">Consultar cupos</a></p>

<%- include('../partials/mensajes') %>

<h2>Mis datos</h2>
<p>Correo: <%= perfil.correo %></p>
<p>Registrado el <%= perfil.fechaRegistro %></p>

<form action="/padre/perfil" method="POST" class="formulario">
  <label>Nombre completo
    <input type="text" name="nombre" value="<%= perfil.nombre %>">
  </label>
  <label>Número de teléfono
    <input type="tel" name="telefono" value="<%= perfil.telefono %>">
  </label>
  <button type="submit" class="btn">Guardar cambios</button>
</form>

<h2>Cambiar contraseña</h2>
<form action="/padre/perfil/password" method="POST" class="formulario">
  <label>Contraseña actual
    <input type="password" name="passwordActual">
  </label>
  <label>Nueva contraseña
    <input type="password" name="passwordNueva">
  </label>
  <label>Confirmar nueva contraseña
    <input type="password" name="confirmarPassword">
  </label>
  <button type="submit" class="btn">Cambiar contraseña</button>
</form>

<%- include('../layouts/footer') %>
